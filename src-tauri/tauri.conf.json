{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViveStream-Next",
  "version": "2.5.1",
  "identifier": "com.localghost.vivestream-next",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ViveStream-Next",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/ViveStream/**",
          "$VIDEO/ViveStream/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
