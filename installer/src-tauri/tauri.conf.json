{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViveStream-Next-Setup",
  "version": "3.7.0",
  "identifier": "com.localghost.vivestream-next.installer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ViveStream Setup",
        "width": 860,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
