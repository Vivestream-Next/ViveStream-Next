{
  "name": "vivestream-next",
  "version": "2.7.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "bun run tauri dev",
    "dev": "vite",
    "build": "vite build",
    "build:packages": "bun ./scripts/build-packages.js",
    "build:all": "bun ./scripts/build-packages.js --all",
    "build:linux": "bun ./scripts/build-packages.js --linux",
    "build:deb": "bun ./scripts/build-packages.js --deb",
    "build:appimage": "bun ./scripts/build-packages.js --appimage",
    "build:arch": "bun ./scripts/build-packages.js --arch",
    "build:rpm": "bun ./scripts/build-packages.js --rpm",
    "build:win": "bun ./scripts/build-packages.js --win",
    "build:exe": "bun ./scripts/build-packages.js --exe",
    "build:msi": "bun ./scripts/build-packages.js --msi",
    "serve": "vite preview",
    "tauri": "tauri",
    "cleanup": "cd src-tauri && cargo clean && rm -rf target gen && cd .. && rm -rf node_modules dist pkg PKGBUILD.1",
    "init": "cd src-tauri && cargo build && cd .. && bun install && vite build",
    "test": "vitest run",
    "test:pot": "cargo run --manifest-path src-tauri/Cargo.toml -- --test-pot",
    "version:verify": "bun ./scripts/verify-versions.js",
    "bump": "bun ./scripts/bump.js",
    "bump:patch": "bun ./scripts/bump.js patch",
    "bump:minor": "bun ./scripts/bump.js minor",
    "bump:major": "bun ./scripts/bump.js major",
    "release:tag": "bun ./scripts/bump.js --tag",
    "format": "bunx prettier -w -u . && cd src-tauri && cargo fmt --all"
  },
  "license": "BSL-1.1",
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "@solidjs/router": "^1.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "~2",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^30.0.1",
    "solid-testing-library": "^0.5.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0"
  }
}
